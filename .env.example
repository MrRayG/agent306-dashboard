# ─────────────────────────────────────────────────────────────
#  Agent 306 — Environment Variables
# ─────────────────────────────────────────────────────────────

# ── Core LLM API (free tier) ──────────────────────────────────
# Free mode is ON when GEMINI_API_KEY or GROQ_API_KEY is set. All LLM calls
# go to Gemini first and fall back to Groq; Perplexity research is replaced
# by Tavily search + the LLM. See server/freeLLM.ts.
GEMINI_API_KEY=               # Google AI Studio key — primary LLM (https://aistudio.google.com/apikey)
GROQ_API_KEY=                 # Groq key — fallback LLM (https://console.groq.com/keys)
TAVILY_API_KEY=               # Tavily key — web search for research (https://app.tavily.com), 1,000 free credits/mo
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# FREE_LLM_ROUTING=true       # Set to "false" to restore the legacy OpenRouter/xAI/Perplexity routing

# ── Legacy paid LLM keys (no longer needed in free mode) ──────
# OPENROUTER_API_KEY=         # Legacy OpenRouter key
# GROK_API_KEY=               # Legacy xAI key — only needed for xAI TTS / image / video / live X search
# XAI_API_KEY=                # Alias of GROK_API_KEY for the reflection-video lane
# PERPLEXITY_API_KEY=         # Legacy Perplexity Sonar key (replaced by TAVILY_API_KEY)

# ── Reflection video lane (PR #417) ──────────────────────────
# Manual / draft-only. When enabled, the Command Center reflection card
# exposes an "Include video" toggle that triggers a 9:16 grok-imagine-video
# clip and attaches it to the reflection tweet draft. Nothing auto-posts.
REFLECTION_VIDEO_ENABLED=false      # Master flag — OFF by default (requires a paid xAI key; disabled in free mode)
REFLECTION_VIDEO_DAILY_CAP=3        # Hard daily cap (resets at UTC midnight)
REFLECTION_VIDEO_DURATION_SEC=8     # Clip length in seconds (xAI duration)

# ── External Data Source API Keys ────────────────────────────
COINGECKO_DEMO_API_KEY=       # Optional free CoinGecko Demo key (sent as x-cg-demo-api-key). Keyless works if unset.
CORE_API_KEY=                 # Optional — core.ac.uk academic papers (skipped if unset)
NEWSAPI_KEY=                  # Optional — newsapi.org (skipped if unset; RSS + HN cover news)
# ELEVENLABS_API_KEY=         # Optional — podcast/voice audio (off if unset)
# NEYNAR_API_KEY=             # Optional — Farcaster cross-posting (off if unset)
BIBLE_API_KEY=                # Optional. Sign up at https://scripture.api.bible/ — used by WisdomEngine. If unset or invalid (401), the Bible source is skipped quietly so logs stay clean.

# ── Configurable Settings ────────────────────────────────────
GOAL_COOLDOWN_HOURS=8         # Min hours between goal engine runs (was 20)
MAX_HYPOTHESIS_QUEUE=250      # Hard cap on active hypotheses (forming+testing) before refusing new intake

# ── Hypothesis intake policy (propose-only / soft mode) ──────────────────
# Soft, propose-only cap and shape controls. Defaults remain unchanged
# until an operator opts in. Hard refusal stays at MAX_HYPOTHESIS_QUEUE.
# HYPOTHESIS_MAX_ACTIVE=25                  # Soft target for active backlog (cap-pressure surfaced in the Intake Audit panel)
# HYPOTHESIS_MAX_NEW_PER_CYCLE=5            # Soft target on new hypotheses per daily cycle (advisory only)
# HYPOTHESIS_STALE_DAYS=30                  # Active records older than this are flagged for review/archive in the audit
# HYPOTHESIS_MANUAL_BACKLOG_THRESHOLD=50    # Manual-backlog gate threshold (rewrite_* + needs_operator_review + unpromoted memory-origin)
# INTAKE_GATE_SOFT=1                        # Route quality-gate failures to hygieneTag='needs_review' (stored, not dropped)
# INTAKE_SOFT_MAX_ACTIVE=25                 # Override soft active cap independently of HYPOTHESIS_MAX_ACTIVE
# HYPOTHESIS_BLOCK_ON_BACKLOG=1             # When ON + INTAKE_GATE_SOFT=1, route new candidates to needs_review while manual backlog is over threshold

# ── Optional LLM Timeout Overrides (milliseconds) ───────────
# LLM_TIMEOUT_HYPOTHESIS=60000
# LLM_TIMEOUT_ADVERSARIAL=60000
# LLM_TIMEOUT_TRIAD_FACT=90000
# LLM_TIMEOUT_TRIAD_LOGIC=120000
# LLM_TIMEOUT_TRIAD_GENERATE=150000
# LLM_TIMEOUT_TRIAD_REVISION=150000
# LLM_TIMEOUT_TRIAD_GROUNDING=90000
# LLM_TIMEOUT_CONSOLIDATION=45000
# LLM_TIMEOUT_GOAL=45000
# LLM_TIMEOUT_DEFAULT=60000

# ── Infrastructure ───────────────────────────────────────────
# DATA_DIR=/data              # Railway persistent volume mount
# TRIAD_ENABLED=false         # Enable Agentic Triad pipeline

# ── Telegram bot (remote chat with Agent 306) ───────────────
# Get a token from @BotFather on Telegram, then set these to enable /api/telegram/*.
TELEGRAM_BOT_TOKEN=                 # Token from @BotFather (e.g. 123456:ABC-DEF...)
TELEGRAM_ALLOWED_USER_IDS=          # Comma-separated numeric Telegram user IDs allowed to chat
TELEGRAM_WEBHOOK_SECRET=            # Optional shared secret Telegram sends in the header (recommended)
# PUBLIC_BASE_URL=                  # Optional: force the base URL used for the self-call to /api/chat/send
                                    # (auto-derived from the incoming request if unset)

# Voice few-shot: anchors blog/podcast/article/reply prompts on the last 3
# published posts. Leave OFF until engagement signal is strong enough to act
# as a real quality floor (>=3 posts above an engagement bar).
# VOICE_EXEMPLARS_ENABLED=false

# ── Self-Evolution Foundation (docs/SELF_EVOLUTION.md) ──────────────
# AGENT306_GH_TOKEN: optional — when set, githubBridge can register draft-PR
# URLs on approved self-recommendations with diffs. Without it, the bridge
# falls back to writing the proposed patch to data/proposed_patches/<id>.patch
# for manual application. Never used for auto-merge.
# AGENT306_GH_TOKEN=
# AGENT306_GH_REPO=MrRayG/agent306-dashboard
# AGENT306_GH_BASE=main

# USE_DB_STATE: default true. Repositories in server/repositories/ read
# through the DB first and fall back to data/*.json on miss. Set to "false"
# to force JSON reads (used for rollback from the one-shot migration).
# USE_DB_STATE=true

# PROMOTION_GATE_ALLOW_HIGH_RISK: default false. The promotion gate blocks
# every high-risk self-recommendation (category=schema|architecture) by
# default, even when golden sets pass. Flip to "true" as an explicit
# operator override per-deployment. Set back to false after the apply.
# PROMOTION_GATE_ALLOW_HIGH_RISK=false

# PRIMITIVE_REGISTRY_ENABLED: default false. Master flag for the
# self-evolving primitives architecture scaffolding (PR #422). When OFF,
# the action translator does not consult the registry — behaviour is
# byte-identical to pre-#422 main. When ON and zero primitives are
# registered (today's state), behaviour is still byte-identical: the
# registry lookup returns null and translation falls through to
# `{ primitive: "none", ... }`. Subsequent PRs (#423 synthesis, #424
# artifact, #425 other) will register executors. Flip to "true" only
# after all three land and observed-stable.
# PRIMITIVE_REGISTRY_ENABLED=false

# PRIMITIVE_SYNTHESIS_EXECUTOR_ENABLED: default false. Per-executor flag
# for the synthesis primitive scaffold registered by the bootstrap
# module (this PR). When OFF (default), `bootstrapPrimitives()` does
# NOT register the synthesis executor and the registry remains empty
# for the `synthesis` family — translator behaviour is byte-identical.
# When ON, the master registry flag must ALSO be ON for the executor
# to be reachable. Until the translator-dispatch follow-up lands, even
# a registered executor is unreachable from the production translator
# path (PR #423's `void registered;` pattern is preserved).
# PRIMITIVE_SYNTHESIS_EXECUTOR_ENABLED=false

# PRIMITIVE_SYNTHESIS_EXECUTOR_DRY_RUN: default true (dry-run) whenever
# the executor is enabled. Operators must explicitly set this to "false"
# to opt OUT of dry-run, AND the executor must have a production engine
# wired in — which today it does NOT. The non-dry-run branch refuses
# with a structured `ok: false` reason. There is no flag-only path to
# real side effects.
# PRIMITIVE_SYNTHESIS_EXECUTOR_DRY_RUN=true

# PRIMITIVE_ARTIFACT_EXECUTOR_ENABLED: default false. Per-executor flag
# for the artifact primitive scaffold registered by the bootstrap
# module (PR #426). When OFF (default), `bootstrapPrimitives()` does
# NOT register the artifact executor and the registry remains empty
# for the `artifact` family — translator behaviour is byte-identical.
# When ON, the master registry flag must ALSO be ON for the executor
# to be reachable. Until the translator-dispatch follow-up lands, even
# a registered executor is unreachable from the production translator
# path (PR #423's `void registered;` pattern is preserved).
# PRIMITIVE_ARTIFACT_EXECUTOR_ENABLED=false

# PRIMITIVE_ARTIFACT_EXECUTOR_DRY_RUN: default true (dry-run) whenever
# the executor is enabled. Operators must explicitly set this to "false"
# to opt OUT of dry-run, AND the executor must have a production engine
# wired in — which today it does NOT. The non-dry-run branch refuses
# with a structured `ok: false` reason. There is no flag-only path to
# real side effects.
# PRIMITIVE_ARTIFACT_EXECUTOR_DRY_RUN=true

# PRIMITIVE_OTHER_EXECUTOR_ENABLED: default false. Per-executor flag
# for the other (catch-all) primitive scaffold registered by the
# bootstrap module (this PR). When OFF (default), `bootstrapPrimitives()`
# does NOT register the other executor and the registry remains empty
# for the `other` family — translator behaviour is byte-identical.
# When ON, the master registry flag must ALSO be ON for the executor
# to be reachable. Until the translator-dispatch follow-up lands, even
# a registered executor is unreachable from the production translator
# path (PR #423's `void registered;` pattern is preserved).
# PRIMITIVE_OTHER_EXECUTOR_ENABLED=false

# PRIMITIVE_OTHER_EXECUTOR_DRY_RUN: default true (dry-run) whenever
# the executor is enabled. Operators must explicitly set this to "false"
# to opt OUT of dry-run, AND the executor must have a production engine
# wired in — which today it does NOT. The non-dry-run branch refuses
# with a structured `ok: false` reason. There is no flag-only path to
# real side effects.
# PRIMITIVE_OTHER_EXECUTOR_DRY_RUN=true

# PRIMITIVE_SYNTHESIS_READ_ONLY_PLANNER_ENABLED: default false. Install
# gate for the read-only synthesis planning adapter (PR #432 / PR #433).
# When OFF (default), `bootstrapPrimitives()` does NOT install the read-
# only planning adapter — the synthesis adapter slot resolves to the
# pure `defaultSynthesisAdapter` shipped by PR #431 and production
# posture is byte-identical. When ON, bootstrap swaps the slot to
# `createReadOnlyPlanningAdapter()` so the dispatch stack can surface
# structured planner metadata via the existing dry-run executor path.
# The adapter remains pure / read-only / dry-run-only. The synthesis
# executor's non-dry-run branch still refuses; there is no flag
# combination reachable today that bypasses that refusal. The master
# registry flag, the synthesis executor enable flag, and the synthesis
# dry-run flag must ALL be ON for the install to occur.
# PRIMITIVE_SYNTHESIS_READ_ONLY_PLANNER_ENABLED=false
