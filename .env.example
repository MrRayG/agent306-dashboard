# ─────────────────────────────────────────────────────────────
#  Agent 306 — Environment Variables
# ─────────────────────────────────────────────────────────────

# ── Core LLM API ──────────────────────────────────────────────
OPENROUTER_API_KEY=           # OpenRouter API key (primary)
GROK_API_KEY=                 # Fallback: native Grok/xAI key
PERPLEXITY_API_KEY=           # Perplexity Sonar for evidence gathering

# ── External Data Source API Keys ────────────────────────────
CORE_API_KEY=                 # From core.ac.uk — academic papers
NEWSAPI_KEY=                  # From newsapi.org — structured news
BIBLE_API_KEY=                # Optional. Sign up at https://scripture.api.bible/ — used by WisdomEngine. If unset or invalid (401), the Bible source is skipped quietly so logs stay clean.

# ── Configurable Settings ────────────────────────────────────
GOAL_COOLDOWN_HOURS=8         # Min hours between goal engine runs (was 20)
MAX_HYPOTHESIS_QUEUE=250      # Max active hypotheses before rejecting new ones

# ── Optional LLM Timeout Overrides (milliseconds) ───────────
# LLM_TIMEOUT_HYPOTHESIS=60000
# LLM_TIMEOUT_ADVERSARIAL=60000
# LLM_TIMEOUT_TRIAD_FACT=90000
# LLM_TIMEOUT_TRIAD_LOGIC=120000
# LLM_TIMEOUT_TRIAD_GENERATE=150000
# LLM_TIMEOUT_TRIAD_REVISION=150000
# LLM_TIMEOUT_TRIAD_GROUNDING=90000
# LLM_TIMEOUT_CONSOLIDATION=45000
# LLM_TIMEOUT_GOAL=45000
# LLM_TIMEOUT_DEFAULT=60000

# ── Infrastructure ───────────────────────────────────────────
# DATA_DIR=/data              # Railway persistent volume mount
# TRIAD_ENABLED=false         # Enable Agentic Triad pipeline

# ── Telegram bot (remote chat with Agent 306) ───────────────
# Get a token from @BotFather on Telegram, then set these to enable /api/telegram/*.
TELEGRAM_BOT_TOKEN=                 # Token from @BotFather (e.g. 123456:ABC-DEF...)
TELEGRAM_ALLOWED_USER_IDS=          # Comma-separated numeric Telegram user IDs allowed to chat
TELEGRAM_WEBHOOK_SECRET=            # Optional shared secret Telegram sends in the header (recommended)
# PUBLIC_BASE_URL=                  # Optional: force the base URL used for the self-call to /api/chat/send
                                    # (auto-derived from the incoming request if unset)

# Voice few-shot: anchors blog/podcast/article/reply prompts on the last 3
# published posts. Leave OFF until engagement signal is strong enough to act
# as a real quality floor (>=3 posts above an engagement bar).
# VOICE_EXEMPLARS_ENABLED=false

# ── Self-Evolution Foundation (docs/SELF_EVOLUTION.md) ──────────────
# AGENT306_GH_TOKEN: optional — when set, githubBridge can register draft-PR
# URLs on approved self-recommendations with diffs. Without it, the bridge
# falls back to writing the proposed patch to data/proposed_patches/<id>.patch
# for manual application. Never used for auto-merge.
# AGENT306_GH_TOKEN=
# AGENT306_GH_REPO=MrRayG/agent306-dashboard
# AGENT306_GH_BASE=main

# USE_DB_STATE: default true. Repositories in server/repositories/ read
# through the DB first and fall back to data/*.json on miss. Set to "false"
# to force JSON reads (used for rollback from the one-shot migration).
# USE_DB_STATE=true

# PROMOTION_GATE_ALLOW_HIGH_RISK: default false. The promotion gate blocks
# every high-risk self-recommendation (category=schema|architecture) by
# default, even when golden sets pass. Flip to "true" as an explicit
# operator override per-deployment. Set back to false after the apply.
# PROMOTION_GATE_ALLOW_HIGH_RISK=false
