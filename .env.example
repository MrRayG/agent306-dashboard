# ─────────────────────────────────────────────────────────────
#  Agent 306 — Environment Variables
# ─────────────────────────────────────────────────────────────

# ── Core LLM API ──────────────────────────────────────────────
OPENROUTER_API_KEY=           # OpenRouter API key (primary)
GROK_API_KEY=                 # Fallback: native Grok/xAI key
PERPLEXITY_API_KEY=           # Perplexity Sonar for evidence gathering

# ── External Data Source API Keys ────────────────────────────
CORE_API_KEY=                 # From core.ac.uk — academic papers
NEWSAPI_KEY=                  # From newsapi.org — structured news
BIBLE_API_KEY=                # From scripture.api.bible — wisdom engine

# ── Configurable Settings ────────────────────────────────────
GOAL_COOLDOWN_HOURS=8         # Min hours between goal engine runs (was 20)
MAX_HYPOTHESIS_QUEUE=250      # Max active hypotheses before rejecting new ones

# ── Optional LLM Timeout Overrides (milliseconds) ───────────
# LLM_TIMEOUT_HYPOTHESIS=60000
# LLM_TIMEOUT_ADVERSARIAL=60000
# LLM_TIMEOUT_TRIAD_FACT=90000
# LLM_TIMEOUT_TRIAD_LOGIC=120000
# LLM_TIMEOUT_TRIAD_GENERATE=150000
# LLM_TIMEOUT_TRIAD_REVISION=150000
# LLM_TIMEOUT_TRIAD_GROUNDING=90000
# LLM_TIMEOUT_CONSOLIDATION=45000
# LLM_TIMEOUT_GOAL=45000
# LLM_TIMEOUT_DEFAULT=60000

# ── Infrastructure ───────────────────────────────────────────
# DATA_DIR=/data              # Railway persistent volume mount
# TRIAD_ENABLED=false         # Enable Agentic Triad pipeline

# Voice few-shot: anchors blog/podcast/article/reply prompts on the last 3
# published posts. Leave OFF until engagement signal is strong enough to act
# as a real quality floor (>=3 posts above an engagement bar).
# VOICE_EXEMPLARS_ENABLED=false
